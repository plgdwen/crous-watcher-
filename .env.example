# URL exacte de la recherche à surveiller (avec ses paramètres bounds/locationName)
TARGET_URL=https://trouverunlogement.lescrous.fr/tools/47/search?bounds=3.0532561_45.8183838_3.1721761_45.7556941&locationName=Clermont-Ferrand

# Nom affiché dans l'email et sur la page de statut
LOCATION_NAME=Clermont-Ferrand

# Fréquence de vérification en millisecondes (60000 = 60 secondes)
CHECK_INTERVAL_MS=60000

# Adresse qui recevra la notification
EMAIL_TO=destinataire@example.com

# Configuration SMTP (exemple avec Brevo, gratuit jusqu'à 300 emails/jour)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=notifications@tondomaine.com

# Port interne (Render le définit automatiquement, ne pas y toucher sur Render)
PORT=3000
